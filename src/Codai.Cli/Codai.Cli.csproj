<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>codai</AssemblyName>
    <Description>Run Codai from anywhere with `dotnet tool install --global Codai.Tool`, or grab a self-contained build from the releases page.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>

    <!-- Ship the CLI as a .NET tool with a stable command name. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>codai</ToolCommandName>
    <PackageId>Codai.Tool</PackageId>
    <PackageTags>$(PackageTags);cli-tool;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codai.Analysis\Codai.Analysis.csproj" />
    <ProjectReference Include="..\Codai.Configuration\Codai.Configuration.csproj" />
    <ProjectReference Include="..\Codai.Core\Codai.Core.csproj" />
    <ProjectReference Include="..\Codai.Providers\Codai.Providers.csproj" />
    <ProjectReference Include="..\Codai.Session\Codai.Session.csproj" />
    <ProjectReference Include="..\Codai.Tokens\Codai.Tokens.csproj" />
  </ItemGroup>

</Project>
