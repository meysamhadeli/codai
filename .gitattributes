# Normalise line endings so byte-parity tests behave identically on every platform.
#
# The prompt template and the pricing catalog are compared byte-for-byte against
# frozen goldens (tests/Codai.Core.Tests/Golden/). If git rewrote their line
# endings on checkout, those comparisons would break on one platform and pass on
# another. Forcing LF keeps them deterministic.

* text=auto

*.cs      text eol=lf
*.csproj  text eol=lf
*.slnx    text eol=lf
*.props   text eol=lf
*.json    text eol=lf
*.tmpl    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.scm     text eol=lf
*.md      text eol=lf

# Binary assets
*.gif     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.ico     binary
